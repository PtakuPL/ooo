			npcHandler:setTopic(playerId, 0)
		end
	elseif MsgContains(message, "origin") then --tome9
		if npcHandler:getTopic(playerId) == 48 then
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_21")
