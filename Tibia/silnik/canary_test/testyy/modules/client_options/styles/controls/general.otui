UIWidget
  anchors.fill: parent
  visible: false
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 22

    OptionCheckBoxMarked
      id: showPing
      !text: tr("otclient_modules.general_otui.tr_18")
      !tooltip: tr("otclient_modules.general_otui.tr_17")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 22
    margin-top: 7

    $mobile:
      height: 0
      margin-top: 0
      visible: false

    OptionCheckBox
      id: classicControl
      !text: tr("otclient_modules.general_otui.tr_16")

      $mobile:
        visible: false

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22
  
    OptionCheckBox
      id: autoChaseOverride
      !text: tr("otclient_modules.general_otui.tr_15")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22
  
    OptionCheckBox
      id: moveStack
      !text: tr("otclient_modules.general_otui.tr_14")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22
  
    OptionCheckBoxMarked
      id: smartWalk
      !text: tr("otclient_modules.general_otui.tr_13")
      !tooltip: tr("otclient_modules.general_otui.tr_12")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22
  
    OptionCheckBox
      id: openMaximized
      !text: tr("otclient_modules.general_otui.tr_11")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22
  
    OptionCheckBox
      id: displayText
      !text: tr("otclient_modules.general_otui.tr_10")
      
  SmallReversedQtPanel
    id: hotkeyDelay_label
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionScaleScroll
      id: hotkeyDelay
      !text: tr("otclient_modules.general_otui.tr_9")
      anchors.fill: parent
      &minimumScrollValue: 30
      &maximumScrollValue: 250
      &scrollSize: 21
      @onSetup: |
        local value = modules.client_options.getOption('hotkeyDelay')
        self:setText(tr("otclient_modules.general_otui.tr_8", value))

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionScaleScroll
      id: walkTurnDelay
      !text: tr("otclient_modules.general_otui.tr_7")
      anchors.fill: parent
      &minimumScrollValue: 10
      &maximumScrollValue: 500
      &scrollSize: 21
      @onSetup: |
        local value = modules.client_options.getOption('walkTurnDelay')
        self:setText(tr("otclient_modules.general_otui.tr_6", value))

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionScaleScroll
      id: walkTeleportDelay
      !text: tr("otclient_modules.general_otui.tr_5")
      anchors.fill: parent
      &minimumScrollValue: 50
      &maximumScrollValue: 500
      &scrollSize: 21
      @onSetup: |
        local value = modules.client_options.getOption('walkTeleportDelay')
        self:setText(tr("otclient_modules.general_otui.tr_4", value))

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    height: 22

    OptionScaleScroll
      id: walkStairsDelay
      !text: tr("otclient_modules.general_otui.tr_3")
      anchors.fill: parent
      &minimumScrollValue: 50
      &maximumScrollValue: 500
      &scrollSize: 21
      @onSetup: |
        local value = modules.client_options.getOption('walkStairsDelay')
        self:setText(tr("otclient_modules.general_otui.tr_2", value))

  QtButton
    id: hotkeysButton
    !text: tr("otclient_modules.general_otui.tr_1")
    @onClick: modules.game_hotkeys.show()
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 12

    size: 120 20
