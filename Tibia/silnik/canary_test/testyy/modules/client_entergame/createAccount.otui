          $disabled:
            image-source: /images/ui/createaccount/icon-no

        Label
          text-auto-resize: true
          color: #3F3F3F
          !text: tr("otclient_modules.createaccount_otui.tr_18")
          text-offset: 10 2
      Panel
        height: 14
        layout: horizontalBox
        id: HasUpperCase

        UIWidget
          id: icons
          image-source: /images/ui/createaccount/icon-yes
