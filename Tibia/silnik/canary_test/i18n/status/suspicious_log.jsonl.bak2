{"timestamp": "2026-02-14T16:04:38.803509Z", "lang": "es", "category": "npc.json", "key": "npc.barbara.say_3", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "Take this!", "translated": "Take this!"}
{"timestamp": "2026-02-14T16:04:38.811587Z", "lang": "es", "category": "npc.json", "key": "npc.barnabas_dee.say_5", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "word_repetition", "severity": "HIGH", "message": "Powtórzony wyraz 3+ razy"}], "action": "retranslate", "en": "No no no, I need 15 doses of freshly harvested pollen! Please, harvest those 15 doses yourself, to make absolutely sure you have first-rate quality. I am afraid nothing less will do.", "translated": "No no no, necesito 15 dosis de polen recién cosechado! Por favor, coseche esas 15 dosis usted mismo para asegurarse de tener una calidad de primer nivel. Me temo que nada menos servirá."}
{"timestamp": "2026-02-14T16:04:38.812535Z", "lang": "es", "category": "npc.json", "key": "npc.barnabas_dee.say_5", "source": "tm", "severity": "HIGH", "issues": [{"type": "word_repetition", "severity": "HIGH", "message": "Powtórzony wyraz 3+ razy"}], "en": "No no no, I need 15 doses of freshly harvested pollen! Please, harvest those 15 doses yourself, to make absolutely sure you have first-rate quality. I am afraid nothing less will do.", "translated": "No no no, necesito 15 dosis de polen recién cosechado! Por favor, coseche esas 15 dosis usted mismo para asegurarse de tener una calidad de primer nivel. Me temo que nada menos servirá."}
