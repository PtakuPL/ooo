  },
  "spell.msg_need_learn": {
    "src_hash": "24c37be7de2773e7687c1bb0b58d66a9",
    "text": "நீங்கள் முதலில் இந்த மந்திரத்தை கற்றுக்கொள்ள வேண்டும்",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-13T00:09:11.376374Z"
  },
  "spell.msg_no_party_in_range": {
    "src_hash": "fca01b330772f55532e24d9cf2108105",
    "text": "வரம்பில் கட்சி உறுப்பினர்கள் இல்லை.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-13T00:09:11.376954Z"
  },
  "spell.msg_no_creatures_around": {
