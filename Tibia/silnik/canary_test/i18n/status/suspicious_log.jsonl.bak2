{"timestamp": "2026-02-14T17:53:55.631681Z", "lang": "es", "category": "npc.json", "key": "npc.gewen.say_5", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "No then.", "translated": "No then."}
