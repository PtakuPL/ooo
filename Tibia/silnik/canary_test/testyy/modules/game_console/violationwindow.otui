MainWindow
  id: ignoreWindow
  !text: tr("otclient_modules.violationwindow_otui.tr_4")
  size: 300 240

  Label
    !text: tr("otclient_modules.violationwindow_otui.tr_3")
    text-wrap: true
    text-auto-resize: true
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

  TextEdit
    id: text
    text-wrap: true
    multiline: true
    anchors.top: prev.bottom
    anchors.bottom: next.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 8 0
    max-length: 255

  Button
    id: buttonOk
    !text: tr("otclient_modules.violationwindow_otui.tr_2")
    width: 64
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: self:getParent():onEnter()

  Button
    id: buttonCancel
    !text: tr("otclient_modules.violationwindow_otui.tr_1")
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: self:getParent():onEscape()