{"timestamp": "2026-02-14T15:02:30.709628Z", "lang": "es", "category": "server.json", "key": "data.otservbr.global.npc.lily.L69.118", "source": "simple", "severity": "LOW", "issues": [{"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >103 znaków bez oczekiwanych diakrytyków dla es"}], "en": "Oh hey, |PLAYERNAME|! Vascalir must have sent you to help me with a little {mission}, right?", "translated": "¡Oye, |PLAYERNAME|! Vascalir debe haberte enviado para que me ayudes con un poco de {mission}, ¿verdad?"}
{"timestamp": "2026-02-14T15:02:30.712778Z", "lang": "es", "category": "server.json", "key": "data.otservbr.global.npc.lily.L72.119", "source": "simple", "severity": "LOW", "issues": [{"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >83 znaków bez oczekiwanych diakrytyków dla es"}], "en": "Hello, |PLAYERNAME|! Back so soon? Have you delivered the herbs to Hyacinth?", "translated": "Hola, |PLAYERNAME|! ¿Volviste tan pronto? ¿Le has entregado las hierbas a Hyacinth?"}
{"timestamp": "2026-02-14T15:02:30.735636Z", "lang": "es", "category": "server.json", "key": "data.otservbr.global.npc.lukosch.L87.215", "source": "simple", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "Welcome, |PLAYERNAME|! Do you feel adventurous? Do you want a weekly {ticket} for the ore wagon system here? You can use it right here to get to the centre of Kazordoon!", "translated": "¡Bienvenido, |PLAYERNAME|! ¿Te sientes aventurero? ¿Quiere un {ticket} semanal para el sistema de vagones de mineral aquí? ¡Puedes usarlo aquí mismo para llegar al centro de Kazordoon!"}
