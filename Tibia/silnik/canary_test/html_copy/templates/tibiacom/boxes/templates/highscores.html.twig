<style type="text/css">
		.top_level {
			position: absolute;
			top: 29px;
			left: 6px;
			height: 160px;
			width: 168px;
			z-index: 20;
			padding-top: 6px;
			padding-right: 4px;
			box-sizing: border-box;
			font-family: Verdana, Arial, Helvetica, sans-serif;
			font-size: 9px;
			line-height: 1.2;
			color: #FFF;
			font-weight: bold;
			text-align: left;
			text-decoration: inherit;
			text-shadow: 1px 1px 1px #333;
			overflow-y: auto;
			overflow-x: hidden;
			scrollbar-width: thin;
		}

	#Topbar a {
		text-decoration: none;
	}

	.online {
		color: #00CC00;
	}

	.offline {
		color: #CC3333;
	}

		a.topfont {
			font-family: Verdana, Arial, Helvetica, sans-serif;
			font-size: 9px;
			text-decoration: none;
			display: block;
			white-space: normal;
			word-break: break-word;
			line-height: 1.25;
			padding: 2px 0;
		}
		a:hover.topfont {
			font-family: Verdana, Arial, Helvetica, sans-serif;
			font-size: 9px;
			color: #CCC;
			text-decoration:none;
		}

		.top_player_entry {
			text-align: left;
			margin-bottom: 3px;
			position: relative;
			min-height: 18px;
			padding-left: 2px;
			border-bottom: 1px solid rgba(255,255,255,0.08);
		}
</style>

<div id="Topbar" class="Themebox" style="background-image:url({{ template_path }}/images/themeboxes/highscores/highscores.png);">
	<div class="top_level" style="background:url({{ template_path }}/images/themeboxes/bg_top.png)">
    {% for player in topPlayers %}
	    <div class="top_player_entry"><a href="{{ getPlayerLink(player['name'], false) }} " class="topfont {% if player['online'] %}online{% else %}offline{% endif %}">
					<span style="color: #CCC;">{{ player['rank'] }}.</span>
					{{ player['name'] }}
				<br>
				<small><span style="color: #AAA;">{{ __('col_level') }}: {{ player['level'] }}</span></small>
		</a>
	</div>
	{% endfor %}
	<div class="Bottom" style="background-image:url({{ template_path }}/images/general/box-bottom.gif); top: 159px; left:-5px;">
	</div>
</div>
</div>
<br/><br/><br/>
