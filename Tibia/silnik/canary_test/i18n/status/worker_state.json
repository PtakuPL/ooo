        "recent_examples": [
          {
            "en": "You are not one of us. I don't want to talk to you.",
            "key": "npc.iskan.greet_msg_1",
            "source": "simple",
            "translated": "Nie jesteś jednym z nas. Nie chcę z tobą rozmawiać."
          },
          {
            "en": "I was told you have been killing huskies here in Svargrond! Never do that again, okay? They are precious animals for us. Give me 500 gold and I will forget that incident without telling it to Jarl Sven. Okay?",
            "key": "npc.iskan.greet_msg_2",
            "source": "simple",
            "translated": "Powiedziano mi, że zabijałeś husky tutaj, w Svargrond! Nigdy więcej tego nie rób, dobrze? To dla nas cenne zwierzęta. Daj mi 500 sztuk złota, a zapomnę o tym incydencie i nic nie powiem Jarlowi Svenowi. Zgoda?"
          },
          {
            "en": "HAIL to the Warlord of the arena! |PLAYERNAME|, Hero of Svargrond! What can I {do for you}?",
            "key": "npc.iskan.greet_msg_3",
            "source": "simple",
            "translated": "CHWAŁA Wodzowi Areny! |PLAYERNAME|, Bohaterze Svargrond! Co mogę dla ciebie {do for you}?"
          },
          {
            "en": "Greetings. What can I {do for you}?",
            "key": "npc.iskan.greet_msg_4",
            "source": "simple",
            "translated": "Pozdrowienia. Co mogę dla ciebie {do for you}?"
          },
          {
            "en": "Oh... farewell, child.",
            "key": "npc.ivalisse.walkaway_msg_1",
            "source": "simple",
            "translated": "Och... żegnaj, dziecko."
          },
          {
            "en": "Feel welcome to my gem store, |PLAYERNAME|.",
            "key": "npc.iwan.greet_msg_1",
            "source": "simple",
            "translated": "Czuj się jak u siebie w moim sklepie z klejnotami, |PLAYERNAME|."
          },
          {
            "en": "Here, take a look.",
            "key": "npc.iwan.sendtrade_msg_1",
            "source": "simple",
            "translated": "Proszę, spójrz."
          },
          {
            "en": "Hiho Storm Killer! Welcome to Kazordoon furniture store.",
            "key": "npc.iwar.greet_msg_1",
            "source": "simple",
            "translated": "Hej ho, Pogromco Burz! Witaj w sklepie meblowym Kazordoon."
          },
          {
            "en": "D...Daraman's blessings... oh, how I m...miss my warm Darashia...",
            "key": "npc.iyad.farewell_msg_1",
            "source": "simple",
            "translated": "B...błogosławieństwo Daramana... och, jak tęsknię za c...ciepłą Darashią..."
          },
          {
            "en": "Finally! A c...c...customer! Wh... where do you want to f...f...{fly}?",
            "key": "npc.iyad.greet_msg_1",
            "source": "simple",
            "translated": "Wreszcie! K...k...klient! G...gdzie chcesz, żebym cię z...z...{fly}?"
          },
          {
            "en": "Yes? What can I do for you? I hope this won't take long, though.",
            "key": "npc.jack.greet_msg_3",
            "source": "simple",
            "translated": "Tak? Co mogę dla ciebie zrobić? Mam nadzieję, że to nie potrwa długo."
          },
          {
            "en": "Welcome on board, |PLAYERNAME|. Where can I {sail} you today? I can travel you back to {thais}.",
            "key": "npc.jack_drone.greet_msg_1",
            "source": "simple",
            "translated": "Witaj na pokładzie, |PLAYERNAME|. Dokąd mam cię dziś {sail}? Mogę zabrać cię z powrotem do {thais}."
          },
          {
            "en": "Welcome on board, Sir |PLAYERNAME|.",
