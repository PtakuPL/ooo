MainWindow
  size: 400 110
  !text: tr("otclient_modules.gift_otui.tr_3")
  @onEnter: modules.game_shop.confirmGift()

  Button
    id: buttonConfirm
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    !text: tr("otclient_modules.gift_otui.tr_2")
    width: 64
    @onClick: modules.game_shop.confirmGift()

  Button
    id: buttonCancel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    !text: tr("otclient_modules.gift_otui.tr_1")
    width: 64
    @onClick: modules.game_shop.cancelGift()

  TextEdit
    id: targetName
    anchors.top: parent.top
    anchors.left: buttonCancel.right
    anchors.right: buttonConfirm.left
    margin-left: 10
    margin-right: 10