UIWidget
  anchors.fill: parent
  visible: false
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

    min-height: 22
  
    OptionCheckBox
      id: displayNames
      !text: tr("otclient_modules.hud_otui.tr_4")
      text-wrap: true

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    min-height: 22
  
    OptionCheckBox
      id: displayHealth
      !text: tr("otclient_modules.hud_otui.tr_3")
      text-wrap: true

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    min-height: 22
  
    OptionCheckBox
      id: displayMana
      !text: tr("otclient_modules.hud_otui.tr_2")
      text-wrap: true

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    min-height: 22

    $!mobile:
      height: 0
      margin-top: 0
      visible: false
  
    OptionCheckBox
      id: rightJoystick
      !text: tr("otclient_modules.hud_otui.tr_1")
      text-wrap: true

      $!mobile:
        visible: false
      
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    min-height: 22
    margin-top: 7
    OptionScaleScroll
      id: hudScale
      anchors.fill: parent
      &minimumScrollValue: 1
      &maximumScrollValue: 5
      &scrollSize: 21

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    min-height: 22
    margin-top: 7
    OptionScaleScroll
      id: creatureInformationScale
      anchors.fill: parent
      &minimumScrollValue: 1
      &maximumScrollValue: 9
      &scrollSize: 21

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    min-height: 22

    OptionScaleScroll
      id: staticTextScale
      anchors.fill: parent
      &minimumScrollValue: 1
      &maximumScrollValue: 9
      &scrollSize: 21

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 7
    min-height: 22

    OptionScaleScroll
      id: animatedTextScale
      anchors.fill: parent
      &minimumScrollValue: 1
      &maximumScrollValue: 9
      &scrollSize: 21
