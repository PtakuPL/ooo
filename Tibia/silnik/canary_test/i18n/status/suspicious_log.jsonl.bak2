{"timestamp": "2026-02-14T18:16:52.703793Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.voice_2", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "action": "retranslate", "en": "He will PAY for this... They will ALL pay!", "translated": "Él PAGARÁ por esto... ¡TODOS pagarán!"}
