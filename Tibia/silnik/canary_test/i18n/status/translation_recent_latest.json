    {
      "key": "data.otservbr.global.scripts.lib.register.actions.L430.1631",
      "en": "You dug a hole! Walk onto it as long as it is open to jump down into the forest cave.",
      "translated": "¡Cavaste un agujero! Camina sobre él mientras esté abierto para saltar hacia abajo a la cueva del bosque.",
      "source": "simple"
    },
    {
      "key": "data.otservbr.global.scripts.lib.register.actions.L438.1632",
      "en": "You found a piece of the scroll. You pocket it quickly.",
      "translated": "Encontraste un trozo del pergamino. Lo guardas rápidamente.",
      "source": "simple"
    },
    {
      "key": "data.otservbr.global.scripts.lib.register.actions.L443.1633",
      "en": "A torn scroll piece emerges. Probably gnawed off by rats.",
      "translated": "Aparece un trozo de pergamino roto. Probablemente roído por ratas.",
      "source": "simple"
    },
    {
      "key": "data.otservbr.global.scripts.lib.register.actions.L539.1635",
      "en": "This table is made of several old doors. One of them has a noticeable ornate lock. Perhaps you could lever it out with a tool.",
      "translated": "Esta mesa está hecha de varias puertas viejas. Una de ellas tiene una cerradura ornamentada notable. Quizás podrías sacarla con una herramienta.",
      "source": "simple"
    },
    {
      "key": "data.otservbr.global.scripts.lib.register.actions.L542.1636",
      "en": "You already removed the old lock.",
      "translated": "Ya retiraste la cerradura vieja.",
      "source": "simple"
    },
    {
