			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_12")
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_13")
			npcHandler:setTopic(playerId, 0)
		end
	elseif MsgContains(message, "thrones") then --tome12
		if npcHandler:getTopic(playerId) == 51 then
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_1")
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_2")
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_3")
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_4")
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_5")
			NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.cael.multi_6")
			npcHandler:setTopic(playerId, 0)
		end
