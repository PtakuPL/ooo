# =============================================================
# .env.example — szablon konfiguracji API
# Skopiuj jako .env i uzupełnij prawdziwe wartości.
# NIGDY nie commituj .env z prawdziwymi hasłami/kluczami!
# =============================================================

URL='http://127.0.0.1'
SERVER_PATH=''

# Database connection
DB_HOST='127.0.0.1'
DB_NAME='canaryaac'
DB_USER='root'
DB_PASS='ZMIEN_HASLO'
DB_PORT='3306'

# K47/K48: opcjonalne osobne bazy gry per-serwer.
# Jeśli puste, API fallbackuje do DB_* (single-db).
# DB_GAME_CLASSIC74_HOST='127.0.0.1'
# DB_GAME_CLASSIC74_NAME='canaryaac'
# DB_GAME_CLASSIC74_USER='root'
# DB_GAME_CLASSIC74_PASS='ZMIEN_HASLO'
# DB_GAME_CLASSIC74_PORT='3306'
# DB_GAME_MODERN_HOST='127.0.0.1'
# DB_GAME_MODERN_NAME='canary_modern'
# DB_GAME_MODERN_USER='root'
# DB_GAME_MODERN_PASS='ZMIEN_HASLO'
# DB_GAME_MODERN_PORT='3306'

ENGINE_DB_HOST=127.0.0.1
ENGINE_DB_NAME=canary
ENGINE_DB_USER=root
ENGINE_DB_PASS=ZMIEN_HASLO
ENGINE_DB_PORT=3306

# Engine DB for modern world (worldId=1)
ENGINE_MODERN_DB_HOST=127.0.0.1
ENGINE_MODERN_DB_NAME=canary_modern
ENGINE_MODERN_DB_USER=root
ENGINE_MODERN_DB_PASS=ZMIEN_HASLO
ENGINE_MODERN_DB_PORT=3306

# Config argon2
M_COST='1<<16'
T_COST='2'
PARALLELISM='2'

# Website configs
SITE_NAME=CanaryAAC
MAINTENANCE=false
DEV_MODE=false
MULTI_WORLD=true

# PagSeguro
PAGSEGURO_EMAIL=''
PAGSEGURO_TOKEN=''

# Mercado Pago
MERCADOPAGO_TOKEN=''
MERCADOPAGO_KEY=''
MERCADOPAGO_CLIENTID=''
MERCADOPAGO_SECRET=''

# Paypal
PAYPAL_MODE='sandbox'
PAYPAL_CLIENT_ID='ZMIEN'
PAYPAL_CLIENT_SECRET='ZMIEN'
PAYPAL_CURRENCY='USD'
PAYPAL_BRAND='Tibia Coins'

# Mail
MAIL_SMTP='smtp://localhost'
MAIL_WEB='contact@example.com'

# Outfits Folder
OUTFITS_FOLDER='/resources/images/charactertrade/outfits'

# Ustawienia połączenia ze światem Canary
OTS_SERVER_NAME="Canary Server"
OTS_IP="127.0.0.1"
OTS_PORT="7172"
OTS_GAME_HOST="127.0.0.1"
OTS_GAME_PORT="7172"

# FIX24: IP/port światów gry zwracane klientowi przez login.php
# Domyślne — używane gdy brak WORLD_CLASSIC74_IP/WORLD_MODERN_IP
WORLD_IP='127.0.0.1'
WORLD_PORT=7172
# Opcjonalne: osobne IP/port per gameMode (jeśli różne serwery)
#WORLD_CLASSIC74_IP='127.0.0.1'
#WORLD_CLASSIC74_PORT=7172
#WORLD_MODERN_IP='127.0.0.1'
#WORLD_MODERN_PORT=7174

# Status/parametry świata
OTS_STATUS="true"
OTS_PVP_TYPE="open"
OTS_LOCATION="EUR"
DEBUG=false

# --- Ticket-Gate (B1-B4) ---
# Klucz tajny HMAC-SHA256 dla ticket-gate. MUSI być identyczny z ticketSecret w config.lua Canary.
# Wygeneruj: php -r "echo bin2hex(random_bytes(32));"
TICKET_SECRET='ZMIEN_WYGENERUJ_NOWY_KLUCZ'
# TTL ticketu w sekundach (domyślnie 30s)
TICKET_TTL=30
# SESSION TTL w sekundach (domyślnie 30 minut)
SESSION_TTL=1800

# --- Launcher (Faza E) ---
LAUNCHER_VERSION='1.0.0'
LAUNCHER_MIN_VERSION='1.0.0'
LAUNCHER_DOWNLOAD_URL='/files/launcher/launcher.exe'
LAUNCHER_SHA256=''
LAUNCHER_RELEASE_DATE=''
LAUNCHER_NOTES='Initial release'

# --- Bootstrap Launcher (BL-16) ---
# Lekki launcher (~KB) pobierany ze strony, instaluje pełny launcher
BOOTSTRAP_VERSION='1.0.0'
BOOTSTRAP_DOWNLOAD_URL_WIN='/files/bootstrap/launcher-bootstrap-windows-x86_64.exe'
BOOTSTRAP_DOWNLOAD_URL_LINUX='/files/bootstrap/launcher-bootstrap-linux-x86_64'
BOOTSTRAP_SHA256_WIN=''
BOOTSTRAP_SHA256_LINUX=''
BOOTSTRAP_RELEASE_DATE=''
BOOTSTRAP_NOTES='Lekki launcher — pobiera i instaluje pełną wersję'
LAUNCH_TOKEN_TTL=300
LAUNCH_TOKEN_RATE_LIMIT=5
CLIENT_FILES_DIR='/sciezka/do/klienta'
FILES_BASE_URL='https://twoj-serwer.pl/files'
UPDATE_CHANNEL='stable'

# --- Social OAuth (K15+) ---
# Google OAuth credentials (launcher social login/link).
GOOGLE_OAUTH_CLIENT_ID=''
GOOGLE_OAUTH_CLIENT_SECRET=''
GOOGLE_OAUTH_REDIRECT_URI='https://twoj-serwer.pl/apik/v1/oauth-callback.php?provider=google'
GOOGLE_OAUTH_SCOPE='openid email profile'
# Facebook OAuth credentials.
FACEBOOK_OAUTH_CLIENT_ID=''
FACEBOOK_OAUTH_CLIENT_SECRET=''
FACEBOOK_OAUTH_REDIRECT_URI='https://twoj-serwer.pl/apik/v1/oauth-callback.php?provider=facebook'
FACEBOOK_OAUTH_SCOPE='email public_profile'
FACEBOOK_OAUTH_GRAPH_VERSION='v19.0'
# Steam OpenID callback + optional profile enrichment key.
STEAM_OAUTH_REDIRECT_URI='https://twoj-serwer.pl/apik/v1/oauth-callback.php?provider=steam'
# Optional realm override (default: origin from STEAM_OAUTH_REDIRECT_URI).
STEAM_OAUTH_REALM='https://twoj-serwer.pl'
STEAM_WEB_API_KEY=''
# Timeout for OAuth/OpenID HTTP calls (seconds).
OAUTH_HTTP_TIMEOUT=10
# Backward-compatible alias used by older Google-only flow.
GOOGLE_OAUTH_HTTP_TIMEOUT=10
# State TTL (seconds) for oauth-start.php.
OAUTH_STATE_TTL=300
# Global auto-link policy by email (can be overridden per provider below).
OAUTH_LINK_BY_EMAIL=true
OAUTH_REQUIRE_VERIFIED_EMAIL=true
# If true, callback can auto-link to existing local account by email.
GOOGLE_OAUTH_LINK_BY_EMAIL=true
# If true, unverified provider email is not used for auto-link/create.
GOOGLE_OAUTH_REQUIRE_VERIFIED_EMAIL=true
# Facebook overrides for auto-link policy.
FACEBOOK_OAUTH_LINK_BY_EMAIL=true
FACEBOOK_OAUTH_REQUIRE_VERIFIED_EMAIL=true
# If true, oauth-start.php requires PKCE codeVerifier and callback validates it.
GOOGLE_OAUTH_REQUIRE_PKCE=false
# Facebook PKCE requirement.
FACEBOOK_OAUTH_REQUIRE_PKCE=false
# Fallback email domain when provider does not return a usable email.
OAUTH_FALLBACK_EMAIL_DOMAIN='social.local'
# Optional deep-link target back to launcher after browser callback.
# Example: launcher://oauth-complete
LAUNCHER_OAUTH_RETURN_URI=''
# Enable DB-backed OAuth rate limiting (requires migration 005).
OAUTH_RATE_LIMIT_ENABLED=false
# oauth-start.php limits (per ipHash + provider)
OAUTH_RATE_LIMIT_START_WINDOW=60
OAUTH_RATE_LIMIT_START_MAX=20
# oauth-callback.php limits (per ipHash + provider)
OAUTH_RATE_LIMIT_CALLBACK_WINDOW=300
OAUTH_RATE_LIMIT_CALLBACK_MAX=30

# --- Challenge-response (LR-052) ---
# TTL challenge nonce (sekundy). Launcher hard-failuje dla TTL > 30.
CHALLENGE_TTL=30
# Czy challenge nonce/response są wymagane dla launcher-token.php.
CHALLENGE_REQUIRED=false

# --- Server status endpoint ---
# Timeout TCP check dla server-status.php (ms)
SERVER_STATUS_TIMEOUT_MS=800

# --- Structured security logging ---
SECURITY_LOG_FILE='/var/log/serwercanary/security-events.log'
LOG_IP_SALT='ZMIEN_LOSOWY_SALT'

# --- E11: LaunchToken enforcement ---
# ⚠ FIX16 SYNC: Musi być zsynchronizowane z CLIENT_LOCKED w init.lua
CLIENT_LOCKED=true

# --- INS-60/61: Admin API for server management ---
# Generate admin API key: php -r "echo bin2hex(random_bytes(32));"
# Then insert key hash to DB:
#   php -r "echo hash('sha256', 'YOUR_KEY_HERE');"
#   INSERT INTO admin_api_keys (name, key_hash, permissions) VALUES ('main-admin', '<hash>', '*');
# ADMIN_API_KEY is NOT stored in .env — keys are validated against admin_api_keys DB table.
# Use: curl -H "X-Admin-Key: YOUR_KEY" https://your-server/apik/v1/games-manage.php

# --- INS-68: Production server URLs ---
# API base URL for login.php (used by init_serverlist.lua generation in manifest)
# Override this in production with your actual domain:
API_BASE_URL='http://127.0.0.1/apik/v1'
EXPECTED_FILES_HASH=''
