{"timestamp": "2026-02-14T19:58:40.361492Z", "lang": "es", "category": "npc.json", "key": "npc.captain_haba_open_sea.larboard_1", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "action": "retranslate", "en": "SET FULL SAILS! SEA SERPENT ON THE LARBOARD SIDE!!", "translated": "¡LEVAN LAS VELAS A TODO LADO! ¡¡SERPIENTE MARINA A BALAR !!"}
{"timestamp": "2026-02-14T19:58:40.362048Z", "lang": "es", "category": "npc.json", "key": "npc.captain_haba_open_sea.larboard_1", "source": "tm", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "en": "SET FULL SAILS! SEA SERPENT ON THE LARBOARD SIDE!!", "translated": "¡LEVAN LAS VELAS A TODO LADO! ¡¡SERPIENTE MARINA A BALAR !!"}
