        text-offset: 1 1

      $disabled:
        color: #dfdfdf88
        opacity: 0.8
      $!disabled:
        color: #ffffff
        opacity: 1
    HorizontalSeparator
      margin-top: 5
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
    Label
