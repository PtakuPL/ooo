      !text: tr("otclient_modules.createaccount_otui.tr_38")
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

      PanelCreateYourAccount
        id: panelEmail
        margin-top: -2
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        Label:
          !text: tr("otclient_modules.createaccount_otui.tr_37")
          margin-left: 100
          width: 160




      PanelCreateYourAccount
        id: panelPassword
