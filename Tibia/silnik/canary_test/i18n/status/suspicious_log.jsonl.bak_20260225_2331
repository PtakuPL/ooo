{"timestamp": "2026-02-14T21:44:53.308153Z", "lang": "es", "category": "questlog.json", "key": "questlog.quest_31.mission_11.state_2", "source": "google_translate", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}, {"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >155 znaków bez oczekiwanych diakrytyków dla es"}], "en": "You have talked to Jack and found out that he is not remembering the time accident or Spectulus. Return to Spectulus in the Edron Academy to tell him about your findings.", "translated": "Hablaste con Jack y descubriste que no recuerda el accidente temporal ni Spectulus. Regresa con Spectulus en la Academia Edron para contarle tus hallazgos."}
{"timestamp": "2026-02-14T21:44:53.309720Z", "lang": "es", "category": "questlog.json", "key": "questlog.quest_31.mission_11.state_4", "source": "google_translate", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "You have talked to Jack about the furniture you placed in his house. Report it back to Spectulus in the Edron Academy.", "translated": "Has hablado con Jack sobre los muebles que colocaste en su casa. Infórmalo a Spectulus en la Academia Edron."}
