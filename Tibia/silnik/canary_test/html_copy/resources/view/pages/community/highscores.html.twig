																<option value="1" {% if players.profession == 1 %}selected{% endif %}>{{ __('vocation_sorcerer_plural') }}</option>
																<option value="2" {% if players.profession == 2 %}selected{% endif %}>{{ __('vocation_druid_plural') }}</option>
