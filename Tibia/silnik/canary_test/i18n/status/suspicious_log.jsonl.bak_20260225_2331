{"timestamp": "2026-02-24T22:55:46.867982Z", "lang": "ru", "category": "server.json", "key": "data.otservbr.global.npc.ztiss.L98.98", "source": "google_translate", "severity": "HIGH", "issues": [{"type": "mixed_scripts", "severity": "HIGH", "message": "Wykryto mieszane skrypty Unicode"}], "en": "Be greeted my .. {guezt}.", "translated": "Приветствую тебя, мой .. {guezt}."}
