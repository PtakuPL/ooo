      margin-left: 5
      anchors.top: separadorThee.bottom
      anchors.right: parent.right
      font: noto-12
      @onClick: onClickOkChangeWorld()

    Button
      !text: tr("otclient_modules.createaccount_otui.tr_1")
      size: 115 22
      margin-top: 10
      margin-right: 5
      anchors.top: separadorThee.bottom
      anchors.right: prev.left
      font: noto-12
      @onClick: onClickResetGameWorld()
