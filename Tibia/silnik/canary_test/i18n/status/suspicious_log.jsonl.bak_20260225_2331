{"timestamp": "2026-02-24T22:55:51.376355Z", "lang": "ru", "category": "server.json", "key": "data.otservbr.global.scripts.actions.object.imbuement.shrine.L5.2354", "source": "google_translate", "severity": "HIGH", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}, {"type": "mixed_scripts", "severity": "HIGH", "message": "Wykryto mieszane skrypty Unicode"}], "en": "You did not collect enough knowledge from the ancient Shapers. Visit the Shaper temple in Thais for help.", "translated": "Вы не получили достаточно знаний от древних Создателей. Посетите храм Создателей в Thais за помощью."}
