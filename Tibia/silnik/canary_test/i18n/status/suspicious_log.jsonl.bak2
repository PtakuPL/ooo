{"timestamp": "2026-02-14T18:01:08.763446Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_35", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}, {"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >82 znaków bez oczekiwanych diakrytyków dla es"}], "action": "retranslate", "en": "In the Dragonbone Cemetery, OBVIOUSLY! Must I explain EVERYTHING to you? Now go!", "translated": "En el Cementerio Dragonbone, ¡OBVIAMENTE! ¿Tengo que explicarte TODO? ¡Ahora vete!"}
{"timestamp": "2026-02-14T18:01:08.764221Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_35", "source": "tm", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}, {"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >82 znaków bez oczekiwanych diakrytyków dla es"}], "en": "In the Dragonbone Cemetery, OBVIOUSLY! Must I explain EVERYTHING to you? Now go!", "translated": "En el Cementerio Dragonbone, ¡OBVIAMENTE! ¿Tengo que explicarte TODO? ¡Ahora vete!"}
{"timestamp": "2026-02-14T18:01:08.799806Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_82", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "action": "retranslate", "en": "Now... get out! And never, ever, dare come back! You ruined EVERYTHING!", "translated": "Ahora... ¡fuera! ¡Y nunca jamás te atrevas a volver! ¡Arruinaste TODO!"}
