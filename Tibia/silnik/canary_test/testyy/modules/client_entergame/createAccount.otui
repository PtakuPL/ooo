          enabled: false
          margin-top: 12
          $disabled:
            image-source: /images/ui/createaccount/icon-no

        Label
          text-auto-resize: true
          color: #3F3F3F
          !text: tr("otclient_modules.createaccount_otui.tr_16")
          text-offset: 10 2
  Panel
    id: mainPanelSelectAGameWorldToPlayOn
    size: 712 350
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: imagesBanner.bottom
    anchors.bottom: parent.bottom
    visible: false
    @onSetup: |
      g_keyboard.bindKeyPress('Up', function() 
        local characters = self:recursiveGetChildById('textListAllWorlds')
        characters:focusPreviousChild(KeyboardFocusReason)
        local focusedChild = characters:getFocusedChild()
        if focusedChild then
          characters:ensureChildVisible(focusedChild)
        end
      end, self)
      g_keyboard.bindKeyPress('Down', function() 
        local characters = self:recursiveGetChildById('textListAllWorlds')
        characters:focusNextChild(KeyboardFocusReason)
        local focusedChild = characters:getFocusedChild()
        if focusedChild then
          characters:ensureChildVisible(focusedChild)
        end
      end, self)
    MiniPanel
      id: panelSelectAGameWorldToPlayOn
      size: 712 215
      !text: tr("otclient_modules.createaccount_otui.tr_15")
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      Panel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        id: panelSelectworldAndPvp 
        height: 20
        margin-top: -1
        layout:
          type: horizontalBox
          spacing: 30

        Label
          text-offset: 0 2
          margin-left: 38
          font: noto-12
          !text: tr("otclient_modules.createaccount_otui.tr_14")
        QtComboBox
          id: comboBoxWorld
        Label
          !text: tr("otclient_modules.createaccount_otui.tr_13")
        QtComboBox
          id: comboBoxPvp

      TextList
        id: textListAllWorlds
        background-color: #404040
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        margin-top: 5
        width: 140
        vertical-scrollbar: ListScrollBar

      VerticalQtScrollBar
        id: ListScrollBar
        anchors.top: textListAllWorlds.top
        anchors.right: textListAllWorlds.right
        anchors.bottom: textListAllWorlds.bottom
        step: 14
        pixels-scroll: true
      MiniPanel
        id: worldInfo
        !text: tr("otclient_modules.createaccount_otui.tr_12")
        background-color: #404040
        anchors.top: panelSelectworldAndPvp.bottom
        anchors.left: textListAllWorlds.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 5
        margin-top: 5
        !text: tr("otclient_modules.createaccount_otui.tr_11")
        layout: verticalBox

        Panel
          height: 14
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_10")

          Label
            id: PlayersOnline
            text-auto-resize: true
            color: #dfdfdf

        Panel
          height: 14
          margin-top: 5
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_9")

          Label
            id: PvPType
            text-auto-resize: true
            color: #dfdfdf

        Panel
          height: 14
          margin-top: 5
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_8")

          Label
            id: Region
            text-auto-resize: true
            color: #dfdfdf

        Panel
          height: 14
          margin-top: 5
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_7")

          Label
            id: CreationDate
            text-auto-resize: true
            color: #dfdfdf

        Panel
          height: 14
          margin-top: 5
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_6")

          Label
            id: BattlEyeActivationTimestamp
            text-auto-resize: true
            color: #dfdfdf

        Panel
          height: 14
          margin-top: 5
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_5")

          Label
            id: PremiumOnly
            text-auto-resize: true
            color: #dfdfdf

        Panel
          height: 14
          margin-top: 5
          layout: horizontalBox

          Label
            width: 110
            color: #dfdfdf
            !text: tr("otclient_modules.createaccount_otui.tr_4")

          Label
            id: TransferType
            text-auto-resize: true
            color: #dfdfdf

    HorizontalSeparator
      id:separadorThee
      margin-top: 10
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right

    Button
      !text: tr("otclient_modules.createaccount_otui.tr_3")
      size: 115 22
      margin-top: 10
      margin-left: 5
      anchors.top: separadorThee.bottom
      anchors.left: parent.left
