{"timestamp": "2026-02-25T07:39:46.665777Z", "lang": "de", "category": "server.json", "key": "data.otservbr.global.npc.wyda.L132.1254", "source": "google_translate", "severity": "MEDIUM", "issues": [{"type": "de_noun_lowercase", "severity": "MEDIUM", "message": "DE: Rzeczownik po artykule małą literą: banales", "examples": ["banales"]}], "en": "What? A mundane talking to me? Amusing.", "translated": "Was? Ein banales Gespräch mit mir? Amüsant."}
