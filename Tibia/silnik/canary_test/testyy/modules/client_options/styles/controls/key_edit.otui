MainWindow
  size: 400 225
  layout:
    type: verticalBox
    spacing: 10
    fit-children: true
  
  Label
    font: noto-12
    text-align: center
    color: #c0c0c0
    !text: tr("otclient_modules.key_edit_otui.tr_6")
  
  FlatPanel
    id: keyCombo
    height: 33
    font: noto-12
    text-align: center
    color: #c0c0c0
  
  Label
    id: info
    font: noto-12
    color: #c0c0c0
    text-wrap: true
    text-auto-resize: true
  
  Label
    id: alone
    font: noto-12
    color: #c0c0c0
    !text: tr("otclient_modules.key_edit_otui.tr_5")
    visible: false
  
  Label
    id: used
    font: noto-12
    text-align: center
    color: #f75f5f
    !text: tr("otclient_modules.key_edit_otui.tr_4")
    visible: false

  HorizontalSeparator

  Panel
    id: buttons
    height: 20
    layout:
      type: horizontalBox
      align-right: true
      spacing: -5
    
    SmallButton
      id: ok
      width: 40
      !text: tr("otclient_modules.key_edit_otui.tr_3")
    
    SmallButton
      id: clear
      width: 45
      !text: tr("otclient_modules.key_edit_otui.tr_2")
    SmallButton
      id: cancel
      width: 45
      !text: tr("otclient_modules.key_edit_otui.tr_1")

