{"timestamp": "2026-02-14T21:45:46.452778Z", "lang": "es", "category": "questlog.json", "key": "questlog.quest_32.mission_1.name", "source": "google_translate", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "Mission 1: Skulled", "translated": "Mission 1: Skulled"}
{"timestamp": "2026-02-14T21:45:46.453543Z", "lang": "es", "category": "questlog.json", "key": "questlog.quest_32.mission_1.state_1", "source": "google_translate", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "Your mission is to find the Holy Skull. It is in a cave in the northern orc settlement, which is located north-west on the Zao Steppe.", "translated": "Tu misión es encontrar la Santa Calavera. Está en una cueva en el asentamiento orco del norte, que se encuentra al noroeste de la Zao Steppe."}
