{% set title = __('account_section_characters') %}
{% set i18n_key = 'account.section.characters' %}
{% set content %}
<table style="width:100%;">
	<tr>
		<td>
			<div class="TableShadowContainerRightTop">
				<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
			</div>
			<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
				<div class="TableContentContainer">
						<table class="TableContent" width="100%">
							<tr class="LabelH">
									<td style="width:50%" data-i18n="table.header.name">{{ __('table_header_name') }}</td>
									<td style="width:10%" data-i18n="table.header.world">{{ __('table_header_world') }}</td>
									<td style="width:20%" data-i18n="table.header.level">{{ __('table_header_level') }}</td>
									<td style="width:10%" data-i18n="table.header.status">{{ __('table_header_status') }}</td>
								<td style="width:5%">&#160;</td>
							</tr>
							{% set sections = [
								{'key': 'classic74', 'label': world_labels.classic74},
								{'key': 'modern', 'label': world_labels.modern},
								{'key': 'unknown', 'label': world_labels.unknown}
							] %}
							{% for section in sections %}
								{% set worldPlayers = characters_by_world[section.key]|default([]) %}
								{% if active_profile_mode == 'all' or worldPlayers|length > 0 %}
								<tr style="background-color: {{ config.darkborder }};">
									<td colspan="5">
										<b>{{ section.label }}</b>
										{% if server_status is defined and server_status[section.key] is defined %}
											{% if server_status[section.key].online %}
												<span style="color: #00CC00; font-size: 11px; margin-left: 8px;">● ONLINE</span>
												<small style="color: #AAA; margin-left: 4px;">({{ server_status[section.key].players }} online)</small>
											{% else %}
												<span style="color: #CC3333; font-size: 11px; margin-left: 8px;">● OFFLINE</span>
											{% endif %}
										{% endif %}
									</td>
								</tr>
								{% set worldPlayers = characters_by_world[section.key]|default([]) %}
								{% if worldPlayers|length == 0 %}
									<tr style="background-color: {{ config.lightborder }};">
											<td colspan="5"><span>{{ __('account_no_characters_found') }}</span></td>
									</tr>
								{% else %}
									{% for player in worldPlayers %}
										<tr style="background-color: {{ getStyle(loop.index) }};">
											<td>
													<nobr>{{ loop.index }}.
													{% if player.outfit is defined and player.outfit %}
														<img src="{{ player.outfit }}" style="width:32px;height:32px;vertical-align:middle;margin-right:4px;" alt="" />
													{% endif %}
													<a href="{{ getLink('characters') }}/{{ player.name|url_encode }}" style="text-decoration:none;color:inherit;">{{ player.name }}</a>{% if player.deleted %}<span style="color: red"><b data-i18n="account.characters.deleted"> [ {{ __('account_character_deleted_label') }} ] </b></span>{% endif %}</nobr>
											</td>
											<td>
												<nobr>{{ section.label }}</nobr>
											</td>
											<td>
												<nobr>{{ player.level }} {{ player.vocation }}</nobr>
											</td>
											{% if player.online %}
													<td><span style="color: green"><b data-i18n="status.online">{{ __('status_online') }}</b></span></td>
												{% else %}
													<td><span style="color: red"><b data-i18n="status.offline">{{ __('status_offline') }}</b></span></td>
												{% endif %}
												<td>{% if not player.deleted %}[<a href="{{ getLink('account/characters/change-comment?name=' ~ player.editName) }}" data-i18n="text.edit">{{ __('common_edit') }}</a>]{% endif %}</td>
										</tr>
									{% endfor %}
								{% endif %}
								{% endif %}
							{% endfor %}
						</table>
					</div>
				</div>
			<div class="TableShadowContainer">
				<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bm.gif);" >
					<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bl.gif);"></div>
					<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-br.gif);"></div>
