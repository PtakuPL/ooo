  "npc.a_bearded_woman.greet_msg_1": {
    "src_hash": "dec88b2ad57c0b13cc1cf44b9711944a",
    "text": "VADITE ME ODAVDE! SADA!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:43:56.438031Z"
  },
  "npc.a_bearded_woman.stdmod_1": {
    "src_hash": "85b863553a645f3e69472bcbeea15190",
    "text": "U pravednom svijetu, bio bih kapetan velikog broda, ... \\z\n\tOni gusari vani sada bi bili moji miljenici, a mi bismo se hrabro nosili s morima i postali užas obalnih gradova! ... \\z\n\tDa je samo naš plan uspio!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:43:56.438727Z"
  },
  "npc.a_bearded_woman.stdmod_2": {
    "src_hash": "e665aff3c7b262f14bc1bdc6ecab7294",
    "text": "Kapetan Kid prodao je svoj brod kako bi kupio besmislene stvari poput onih suludo skupih brava za vrata ćelija. ... \\z\n\tRekao je da će kanui poslužiti neko vrijeme. ... \\z\n\tStekao sam dojam da nije bio pretjerano tužan što se rastaje od broda jer je poznato da jako boluje od morske bolesti.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:43:56.439389Z"
  },
  "npc.a_bearded_woman.stdmod_3": {
    "src_hash": "d0300a2639da1cea9ef53f1c6c9289c0",
    "text": "Bio bih puno bolji kapetan od Kida. Glumio sam nekoliko kapetana na pozornici i bio sam dobar! ... \\z\n\tTamo gdje je Kid žudio za cijenjenjem svojih ljudi, ja bih vladao strahom i željeznom šakom!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:43:56.439867Z"
  },
