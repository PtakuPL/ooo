<div id="houses" class="Box">
	<div class="Corner-tl" style="background-image:url({{IMAGE_PATH}}/global/content/corner-tl.gif);"></div>
	<div class="Corner-tr" style="background-image:url({{IMAGE_PATH}}/global/content/corner-tr.gif);"></div>
	<div class="Border_1" style="background-image:url({{IMAGE_PATH}}/global/content/border-1.gif);"></div>
	<div class="BorderTitleText" style="background-image:url({{IMAGE_PATH}}/global/content/title-background-green.gif);"></div><img id="ContentBoxHeadline" class="Title" src="{{IMAGE_PATH}}/global/strings/headline-houses.gif" alt="Contentbox headline" data-i18n-attr="alt" data-i18n="image.alt.contentbox_headline|Contentbox headline">
	<div class="Border_2">
		<div class="Border_3">
			<div class="BoxContent" style="background-image:url({{IMAGE_PATH}}/global/content/scroll.gif);">
				<table border="0" cellspacing="1" cellpadding="4">
					<tbody>
						<tr>
							<td valign="top"><img src="{{IMAGE_PATH}}/houses/house_{{ house.house_id }}.png" width="150" height="150" alt="House overview" data-i18n="community.housesview.house_image_alt|House overview" data-i18n-attr="alt"></td>
							<td valign="top">
								<b>{{ house.name }}</b><br><span data-i18n="community.housesview.beds_prefix">This house can have up to</span> {{ house.beds }} <span data-i18n="community.housesview.beds_suffix">beds.</span>
								<br><br><span data-i18n="community.housesview.size_prefix">The house has a size of</span>
								<b>{{ house.size }} <span data-i18n="community.housesview.square_meters_label">square meters</span></b>. <span data-i18n="community.housesview.rent_prefix">The monthly rent is</span>
								<b>{{ house.rent }} <span data-i18n="community.houses.label.gold">gold</span></b>
								<span data-i18n="community.housesview.debited_prefix">and will be debited to the bank account on</span>
								<b>{{ house.world.name }}</b>.<br><br>
								{% if house.owner == 0 %}
									{% if house.last_bid == 0 %}
									<span data-i18n="community.housesview.auction_status">The house is currently being auctioned.</span> <span data-i18n="community.housesview.auction_no_bid">No bid has been submitted so far.</span><br>
									{% endif %}
									{% if house.last_bid != 0 %}
									<span data-i18n="community.housesview.auction_status">The house is currently being auctioned.</span> <span data-i18n="community.housesview.auction_end_prefix">The auction will end at</span> <b>{{ house.bid_date }}</b>.
									<span data-i18n="community.housesview.highest_bid_prefix">The highest bid so far is</span> <b>{{ house.last_bid }} <span data-i18n="community.houses.label.gold">gold</span></b> <span data-i18n="community.housesview.highest_bid_suffix">and has been submitted by</span> <a href="{{URL}}/community/characters/{{ house.highest_bidder_name }}">{{ house.highest_bidder_name }}</a>.
									{% endif %}
								{% else %}
									<span data-i18n="community.housesview.rented_prefix">The house has been rented by</span>
									<a href="{{URL}}/community/characters/{{ house.owner_name }}">{{ house.owner_name }}</a>. <span data-i18n="community.housesview.rented_paid_until">Rent paid until</span>
									<b>{{ house.paid }}</b>.
								{% endif %}
							</td>
						</tr>
					</tbody>
				</table>
				<br>
				<div class="SubmitButtonRow" style="display: flex; justify-content: center;">
					{% if house.owner == 0 %}
						<div class="LeftButton" style="width: 25%;">
							<a href="{{URL}}/community/houses/{{ house.house_id }}/bid" style="padding:0px;margin:0px;">
							<div class="BigButton" style="background-image:url({{IMAGE_PATH}}/global/buttons/button_blue.gif)">
								<div onmouseover="MouseOverBigButton(this);" onmouseout="MouseOutBigButton(this);"><div class="BigButtonOver" style="background-image:url({{IMAGE_PATH}}/global/buttons/button_blue_over.gif);"></div><input class="BigButtonText" type="submit" value="Bid" data-i18n="button.bid|Bid" data-i18n-attr="value"></div>
								</div>
							</a>
						</div>
					{% endif %}
					<div class="LeftButton" style="width: 25%;">
						<a href="{{URL}}/community/houses?world={{ house.world.name }}&town={{ house.town_id }}&state=all&type=houses&order=name" style="padding:0px;margin:0px;">
						<div class="BigButton" style="background-image:url({{IMAGE_PATH}}/global/buttons/button_blue.gif)">
							<div onmouseover="MouseOverBigButton(this);" onmouseout="MouseOutBigButton(this);"><div class="BigButtonOver" style="background-image:url({{IMAGE_PATH}}/global/buttons/button_blue_over.gif);"></div><input class="BigButtonText" type="submit" value="Back" data-i18n="button.back|Back" data-i18n-attr="value"></div>
							</div>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="Border_1" style="background-image:url({{IMAGE_PATH}}/global/content/border-1.gif);"></div>
	<div class="CornerWrapper-b">
		<div class="Corner-bl" style="background-image:url({{IMAGE_PATH}}/global/content/corner-bl.gif);"></div>
	</div>
	<div class="CornerWrapper-b">
		<div class="Corner-br" style="background-image:url({{IMAGE_PATH}}/global/content/corner-br.gif);"></div>
	</div>
</div>
