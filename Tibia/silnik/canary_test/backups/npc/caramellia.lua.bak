local internalNpcName = "Caramellia"
local npcType = Game.createNpcType(internalNpcName)
local npcConfig = {}

npcConfig.name = internalNpcName
npcConfig.description = internalNpcName

npcConfig.health = 100
npcConfig.maxHealth = npcConfig.health
npcConfig.walkInterval = 2000
npcConfig.walkRadius = 2

npcConfig.outfit = {
	lookType = 140,
	lookHead = 96,
	lookBody = 34,
	lookLegs = 34,
	lookFeet = 34,
	lookAddons = 1,
}

npcConfig.flags = {
	floorchange = false,
}

npcConfig.voices = {
	interval = 15000,
	chance = 50,
	{ text = "Can I finally have some peace...?" },
	{ text = "Please leave me alone in my mourning." },
}

local keywordHandler = KeywordHandler:new()
local npcHandler = NpcHandler:new(keywordHandler)

npcType.onThink = function(npc, interval)
	npcHandler:onThink(npc, interval)
end

npcType.onAppear = function(npc, creature)
	npcHandler:onAppear(npc, creature)
end

npcType.onDisappear = function(npc, creature)
	npcHandler:onDisappear(npc, creature)
end

npcType.onMove = function(npc, creature, fromPosition, toPosition)
	npcHandler:onMove(npc, creature, fromPosition, toPosition)
end

npcType.onSay = function(npc, creature, type, message)
	npcHandler:onSay(npc, creature, type, message)
end

npcType.onCloseChannel = function(npc, creature)
	npcHandler:onCloseChannel(npc, creature)
end

keywordHandler:addKeyword({ "mourning" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_1" })
keywordHandler:addKeyword({ "port hope" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_2" })
keywordHandler:addKeyword({ "druid" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_3" })
keywordHandler:addKeyword({ "imprisonment" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_4" })
keywordHandler:addKeyword({ "job" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_5" })
keywordHandler:addKeyword({ "thais" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_6" })
keywordHandler:addKeyword({ "carlin" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_7" })
keywordHandler:addKeyword({ "venore" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_8" })
keywordHandler:addKeyword({ "ab'dendriel" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_9" })
keywordHandler:addKeyword({ "kazordoon" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.caramellia.stdmod_10" })

local function creatureSayCallback(npc, creature, type, message)
	local player = Player(creature)
	local playerId = player:getId()

	if not npcHandler:checkInteraction(npc, creature) then
		return false
	end

	if MsgContains(message, "winfred") then
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_5")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_6")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_7")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_8")
	elseif MsgContains(message, "father") then
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_3")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_4")
	elseif MsgContains(message, "tower") then
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_1")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.caramellia.multi_2")
	end
	return true
end

npcHandler:setMessage(MESSAGE_GREET, "Hello, |PLAYERNAME|. Please leave me alone in my {mourning}.")
npcHandler:setCallback(CALLBACK_MESSAGE_DEFAULT, creatureSayCallback)
npcHandler:addModule(FocusModule:new(), npcConfig.name, true, true, true)

-- npcType registering the npcConfig table
npcType:register(npcConfig)
