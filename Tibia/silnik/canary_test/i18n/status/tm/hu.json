  "npc.a_bearded_woman.greet_msg_1": {
    "src_hash": "dec88b2ad57c0b13cc1cf44b9711944a",
    "text": "SZABAD KI INNEN! JELENLEG!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:44:22.123043Z"
  },
  "npc.a_bearded_woman.stdmod_1": {
    "src_hash": "85b863553a645f3e69472bcbeea15190",
    "text": "Egy igazságos világban egy nagy hajó kapitánya lennék, ... \\z\n\tAzok a kalózok odakint most a csatlósaim lennének, mi pedig a tengerek ellen küzdünk, és a tengerparti városok rettegésévé válunk! ... \\z\n\tHa a tervünk működött volna!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:44:22.123762Z"
  },
  "npc.a_bearded_woman.stdmod_2": {
    "src_hash": "e665aff3c7b262f14bc1bdc6ecab7294",
    "text": "Kid kapitány eladta a hajóját, hogy értelmetlen dolgokat vásároljon, például az őrülten drága zárakat a cellaajtókhoz. ... \\z\n\tAzt mondta, a kenuk egy darabig megteszik. ... \\z\n\tAz volt a benyomásom, hogy nem volt túlságosan szomorú, hogy megváljon a hajótól, mert köztudottan sokat szenved a tengeri betegségtől.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:44:22.124412Z"
  },
  "npc.a_bearded_woman.stdmod_3": {
    "src_hash": "d0300a2639da1cea9ef53f1c6c9289c0",
    "text": "Sokkal jobb kapitány lettem volna, mint Kid volt. Több kapitányt is játszottam a színpadon, és jó voltam! ... \\z\n\tAhol Kölyök emberei megbecsülésére vágyott, én félelemmel és vasököllel uralkodnék!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:44:22.124856Z"
  },
