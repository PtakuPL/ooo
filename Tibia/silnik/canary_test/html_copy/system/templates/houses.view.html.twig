{% set title = houseName %}
{% set content %}

{% if errors is not empty %}
	{% for error in errors %}
		<p class="error">{{ error }}</p>
	{% endfor %}
{% else %}
<table border="0" cellpadding="4" cellspacing="1" width="100%">
	<tr style="display: inline-flex;">
		<td><img src="{{ imgPath }}"></td>
		<td>
			{{ bedsMessage }} i ma rozmiar <b>{{ houseSize }} metrów kwadratowych</b>.

			{% if rentType != 'never' %}
				Czynsz {{ rentType }} wynosi <b>{{ houseRent }} złota</b> i będzie pobierany z konta bankowego na <b>{{ config.lua.serverName }}</b>.
			{% endif %}
			<br>

			{% if owner is not empty  %}
			Ten dom został wynajęty przez <b>{{ owner|raw }}</b>.
			{% else %}
			Nikt jeszcze nie kupił tego domu.
			{% endif %}
		</td>
	</tr>
</table>
{% endif %}

{% endset %}
{% include 'tables.headline.html.twig' %}
<br><br>
