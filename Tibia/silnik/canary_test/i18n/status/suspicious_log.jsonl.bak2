{"timestamp": "2026-02-14T19:58:39.873839Z", "lang": "es", "category": "npc.json", "key": "npc.barbara.say_3", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "Take this!", "translated": "Take this!"}
{"timestamp": "2026-02-14T19:58:39.881869Z", "lang": "es", "category": "npc.json", "key": "npc.barnabas_dee.say_5", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "word_repetition", "severity": "HIGH", "message": "Powtórzony wyraz 3+ razy"}], "action": "retranslate", "en": "No no no, I need 15 doses of freshly harvested pollen! Please, harvest those 15 doses yourself, to make absolutely sure you have first-rate quality. I am afraid nothing less will do.", "translated": "No no no, necesito 15 dosis de polen recién cosechado! Por favor, coseche esas 15 dosis usted mismo para asegurarse de tener una calidad de primer nivel. Me temo que nada menos servirá."}
{"timestamp": "2026-02-14T19:58:39.882818Z", "lang": "es", "category": "npc.json", "key": "npc.barnabas_dee.say_5", "source": "tm", "severity": "HIGH", "issues": [{"type": "word_repetition", "severity": "HIGH", "message": "Powtórzony wyraz 3+ razy"}], "en": "No no no, I need 15 doses of freshly harvested pollen! Please, harvest those 15 doses yourself, to make absolutely sure you have first-rate quality. I am afraid nothing less will do.", "translated": "No no no, necesito 15 dosis de polen recién cosechado! Por favor, coseche esas 15 dosis usted mismo para asegurarse de tener una calidad de primer nivel. Me temo que nada menos servirá."}
{"timestamp": "2026-02-14T19:58:39.963489Z", "lang": "es", "category": "npc.json", "key": "npc.blossom_bonecrusher.say_1", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "Take this!", "translated": "Take this!"}
{"timestamp": "2026-02-14T19:58:40.090692Z", "lang": "es", "category": "npc.json", "key": "npc.brodrosch.say_5", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "No then.", "translated": "No then."}
{"timestamp": "2026-02-14T19:58:40.096788Z", "lang": "es", "category": "npc.json", "key": "npc.brodrosch.walkaway_msg_1", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "Good bye then.", "translated": "Good bye then."}
