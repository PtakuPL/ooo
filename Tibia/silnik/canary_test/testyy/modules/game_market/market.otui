MarketWindow < MainWindow
  id: marketWindow
  !text: tr("otclient_modules.market_otui.tr_6")
  size: 700 530

  @onEscape: Market.close()

  // Main Panel Window

  MarketTabBar
    id: mainTabBar
    width: 164
    height: 25
    anchors.top: parent.top
    anchors.left: parent.left

  Panel
    id: mainTabContent
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    padding: 3
    border-width: 1
    border-color: #000000
    margin-bottom: 20

  Label
    id: balanceLabel
    !text: tr("otclient_modules.market_otui.tr_5") .. ':'
    font: noto-12
    text-offset: 0 2
    anchors.top: parent.top
    anchors.right: parent.right

  Button
    id: closeButton
    !text: tr("otclient_modules.market_otui.tr_4")
    anchors.top: mainTabContent.bottom
    anchors.horizontalCenter: mainTabContent.horizontalCenter
    margin-top: 5
    width: 110
    @onClick: Market.close()

  Button
    id: refreshOffersButton
    !text: tr("otclient_modules.market_otui.tr_3")
    anchors.top: mainTabContent.bottom
    anchors.right: mainTabContent.right
    margin-top: 5
    width: 110
    @onClick: Market.refreshOffers()

  Button
    id: resetButton
    !text: tr("otclient_modules.market_otui.tr_2")
    !tooltip: tr("otclient_modules.market_otui.tr_1")
    anchors.top: mainTabContent.bottom
    anchors.left: mainTabContent.left
    margin-top: 5
    width: 110
    @onClick: Market.reset()