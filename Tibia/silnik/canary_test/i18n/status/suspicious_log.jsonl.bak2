{"timestamp": "2026-02-14T15:14:44.990007Z", "lang": "es", "category": "npc.json", "key": "npc.al_dee.stdmod_41", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "word_salad", "severity": "CRITICAL", "message": "Mix EN function words + partial translation (3/12 = 25%): 'Dedicó su vida a acoger a los recién llegados a es'"}], "action": "fallback_to_google_translate", "en": "He dedicated his life to welcome newcomers to this island.", "translated": "Dedicó su vida a acoger a los recién llegados a esta isla."}
