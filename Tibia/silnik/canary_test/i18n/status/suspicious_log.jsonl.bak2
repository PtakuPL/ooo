{"timestamp": "2026-02-14T19:58:39.768836Z", "lang": "es", "category": "npc.json", "key": "npc.arnold.say_1", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "Take this!", "translated": "Take this!"}
