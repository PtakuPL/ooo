-- Football
local footballKeyword = keywordHandler:addKeyword({ "football" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.lee_delle.stdmod_48" })
footballKeyword:addChildKeyword({ "yes" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.lee_delle.stdmod_49", reset = true }, function(player)
	return player:getMoney() + player:getBankBalance() >= 111
end, function(player)
	if player:removeMoneyBank(111) then
		player:addItem(2990, 1)
	end
end)
footballKeyword:addChildKeyword({ "yes" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.lee_delle.stdmod_50", reset = true })
footballKeyword:addChildKeyword({ "" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.lee_delle.stdmod_51", reset = true })

-- Honey Flower
keywordHandler:addKeyword({ "honey", "flower" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.lee_delle.stdmod_52" }, function(player)
	return player:getItemCount(2984) > 0
end, function(player)
	player:removeItem(2984, 1)
	player:addItem(3362, 1)
end)
keywordHandler:addKeyword({ "honey", "flower" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.lee_delle.stdmod_53" })

NPC_LIB.i18n.setLocalizedMessage(npcHandler, MESSAGE_WALKAWAY, "npc.lee_delle.walkaway_msg_1")
NPC_LIB.i18n.setLocalizedMessage(npcHandler, MESSAGE_FAREWELL, "npc.lee_delle.farewell_msg_1")
npcHandler:setMessage(MESSAGE_SENDTRADE, "Sure, take a look, honey.")
NPC_LIB.i18n.setLocalizedMessage(npcHandler, MESSAGE_GREET, "npc.lee_delle.greet_msg_1")

npcHandler:addModule(FocusModule:new(), npcConfig.name, true, true, true)

