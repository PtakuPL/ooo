	{ itemName = "cherry", clientId = 3590, sell = 1 },
	{ itemName = "dead rat", clientId = 3994, sell = 2 },
	{ itemName = "egg", clientId = 3606, sell = 1 },
	{ itemName = "ham", clientId = 3582, buy = 8, sell = 4 },
