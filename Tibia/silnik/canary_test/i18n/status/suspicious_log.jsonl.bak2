{"timestamp": "2026-02-14T15:08:05.184183Z", "lang": "pl", "category": "scripts.json", "key": "scripts.actions_closed_silvered_trap.msg_2", "source": "simple", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "You may use it in the Feroxa's room.", "translated": "Możesz tego użyć w pokoju Feroxy."}
{"timestamp": "2026-02-14T15:08:05.194648Z", "lang": "pl", "category": "scripts.json", "key": "scripts.actions_coruja.msg_1", "source": "simple", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "You discover an owl resting in a tree. Thats special, because you have never seen an owl in all of Kilmaresh.", "translated": "Odkrywasz sowę odpoczywającą na drzewie. To wyjątkowe, bo nigdy wcześniej nie widziałeś sowy w całym Kilmaresh."}
{"timestamp": "2026-02-14T15:08:26.396754Z", "lang": "es", "category": "npc.json", "key": "npc.a_weakened_forest_fury.say_4", "source": "tm", "severity": "CRITICAL", "issues": [{"type": "identical_to_en", "severity": "CRITICAL", "message": "Tłumaczenie identyczne z EN"}], "action": "fallback_to_google_translate", "en": "Take care, guardian.", "translated": "Take care, guardian."}
