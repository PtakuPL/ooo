local internalNpcName = "Marlene"
local npcType = Game.createNpcType(internalNpcName)
local npcConfig = {}

npcConfig.name = internalNpcName
npcConfig.description = internalNpcName

npcConfig.health = 100
npcConfig.maxHealth = npcConfig.health
npcConfig.walkInterval = 2000
npcConfig.walkRadius = 2

npcConfig.outfit = {
	lookType = 136,
	lookHead = 75,
	lookBody = 56,
	lookLegs = 54,
	lookFeet = 37,
	lookAddons = 0,
}

npcConfig.flags = {
	floorchange = false,
}

local keywordHandler = KeywordHandler:new()
local npcHandler = NpcHandler:new(keywordHandler)

npcType.onThink = function(npc, interval)
	npcHandler:onThink(npc, interval)
end

npcType.onAppear = function(npc, creature)
	npcHandler:onAppear(npc, creature)
end

npcType.onDisappear = function(npc, creature)
	npcHandler:onDisappear(npc, creature)
end

npcType.onMove = function(npc, creature, fromPosition, toPosition)
	npcHandler:onMove(npc, creature, fromPosition, toPosition)
end

npcType.onSay = function(npc, creature, type, message)
	npcHandler:onSay(npc, creature, type, message)
end

npcType.onCloseChannel = function(npc, creature)
	npcHandler:onCloseChannel(npc, creature)
end

keywordHandler:addKeyword({ "name" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.marlene.stdmod_1" })
keywordHandler:addKeyword({ "job" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.marlene.stdmod_2" })
keywordHandler:addKeyword({ "bruno" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.marlene.stdmod_3" })
keywordHandler:addKeyword({ "graubart" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.marlene.stdmod_4" })
keywordHandler:addKeyword({ "thank you" }, StdModule.say, { npcHandler = npcHandler, i18nKey = "npc.marlene.stdmod_5" })

local function creatureSayCallback(npc, creature, type, message)
	local player = Player(creature)
	local playerId = player:getId()

	if not npcHandler:checkInteraction(npc, creature) then
		return false
	end

	if MsgContains(message, "seamonster") then
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_13")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_14")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_15")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_16")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_17")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_18")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_19")
	elseif MsgContains(message, "aneus") then
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_8")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_9")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_10")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_11")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_12")
	elseif MsgContains(message, "rumours") then
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_1")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_2")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_3")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_4")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_5")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_6")
		NPC_LIB.i18n.npcSay(npcHandler, npc, creature, "npc.marlene.multi_7")
	end
	return true
end

npcHandler:setCallback(CALLBACK_MESSAGE_DEFAULT, creatureSayCallback)
npcHandler:setMessage(MESSAGE_GREET, "Ahhh, welcome |PLAYERNAME|! Say, have you already heard the latest news about the {seamonster}, {Aneus}, or the {rumours} in this area?")
npcHandler:setMessage(MESSAGE_FAREWELL, "Good bye and come again for another small talk! *waves*")
npcHandler:addModule(FocusModule:new(), npcConfig.name, true, true, true)

-- npcType registering the npcConfig table
npcType:register(npcConfig)
