global $obRouter;

use App\Http\Response;
use App\Controller\Api;

$obRouter->get('/api/v1/login', [
    'middlewares' => [
        'api'
    ],
    function($request){
        $json = Api\Login::getLogin($request);
$data = is_string($json) ? json_decode($json, true) : $json;
if (isset($data['playdata']['worlds']) && is_array($data['playdata']['worlds'])) {
    foreach ($data['playdata']['worlds'] as &$w) {
        $w['externaladdress']            = '172.29.76.234';
        $w['externaladdressprotected']   = '172.29.76.234';
        $w['externaladdressunprotected'] = '172.29.76.234';
        $w['externalport']               = 7172;
        $w['externalportprotected']      = 7172;
        $w['externalportunprotected']    = 7172;
    }
    unset($w);
}
return new Response(200, $data, 'application/json');
    }
]);
$obRouter->post('/api/v1/login', [
    'middlewares' => [
        'api'
    ],
    function($request){
        $json = Api\Login::getLogin($request);
        $data = is_string($json) ? json_decode($json, true) : $json;
        if (isset($data['playdata']['worlds']) && is_array($data['playdata']['worlds'])) {
            foreach ($data['playdata']['worlds'] as &$w) {
                $w['externaladdress']            = '172.29.76.234';
                $w['externaladdressprotected']   = '172.29.76.234';
                $w['externaladdressunprotected'] = '172.29.76.234';
                $w['externalport']               = 7172;
                $w['externalportprotected']      = 7172;
                $w['externalportunprotected']    = 7172;
            }
            unset($w);
        }
        return new Response(200, $data, 'application/json');
    }
]);
