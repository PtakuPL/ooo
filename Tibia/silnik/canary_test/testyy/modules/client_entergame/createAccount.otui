        Label
          text-auto-resize: true
          color: #3F3F3F
          !text: tr("otclient_modules.createaccount_otui.tr_17")
          text-offset: 10 2
      Panel
        height: 14
        layout: horizontalBox
        id: HasNumber

        UIWidget
          id: icons
          image-source: /images/ui/createaccount/icon-yes
          image-size: 12 9
