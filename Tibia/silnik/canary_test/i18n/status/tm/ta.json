    "updated_at": "2026-02-13T00:09:11.377346Z"
  },
  "spell.msg_cannot_summon_more": {
    "src_hash": "1718b9c7c3db387960dae22e578e4df5",
    "text": "நீங்கள் மேலும் உயிரினங்களை வரவழைக்க முடியாது.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-13T00:09:11.377845Z"
  },
  "npc.a_bearded_woman.greet_msg_1": {
    "src_hash": "dec88b2ad57c0b13cc1cf44b9711944a",
    "text": "என்னை இங்கிருந்து வெளியேற்று! இப்போது!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.111748Z"
  },
  "npc.a_bearded_woman.stdmod_1": {
    "src_hash": "85b863553a645f3e69472bcbeea15190",
    "text": "நியாயமான உலகில், நான் ஒரு பெரிய கப்பலின் கேப்டனாக இருப்பேன், ... \\z\n\tஅங்குள்ள அந்த கடற்கொள்ளையர்கள் இப்போது எனது கூட்டாளிகளாக இருப்பார்கள், நாங்கள் கடல்களைத் தைரியமாகச் சென்று கடற்கரை நகரங்களின் பயங்கரமாக மாறுவோம்! ... \\z\n\tநமது திட்டம் பலித்திருந்தால்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.113392Z"
  },
  "npc.a_bearded_woman.stdmod_2": {
    "src_hash": "e665aff3c7b262f14bc1bdc6ecab7294",
    "text": "கேப்டன் கிட் செல் கதவுகளுக்கான மிகவும் விலையுயர்ந்த பூட்டுகள் போன்ற அர்த்தமற்ற பொருட்களை வாங்குவதற்காக தனது கப்பலை விற்றார். ... \\z\n\tபடகுகள் சிறிது நேரம் செய்யும் என்றார். ... \\z\n\tகப்பலைப் பிரிப்பதற்கு அவர் அதிகம் சோகமாக இல்லை என்ற எண்ணம் எனக்கு ஏற்பட்டது, ஏனென்றால் அவர் கடல் நோயினால் அதிகம் அவதிப்படுகிறார்.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.115186Z"
  },
  "npc.a_bearded_woman.stdmod_3": {
    "src_hash": "d0300a2639da1cea9ef53f1c6c9289c0",
    "text": "சிறுவனை விட நான் சிறந்த கேப்டனாக இருந்திருப்பேன். நான் மேடையில் பல கேப்டன்களாக நடித்தேன், நான் நன்றாக இருந்தேன்! ... \\z\n\tகுழந்தை தனது ஆட்களின் பாராட்டுக்காக ஏங்குகிற இடத்தில், நான் பயத்தினாலும் இரும்புக்கரத்தினாலும் ஆட்சி செய்வேன்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.116320Z"
  },
  "npc.a_bearded_woman.stdmod_4": {
    "src_hash": "2d38ace4459f0ec00320789d297c3501",
    "text": "இது எல்லாம் கேப்டன் கிட் யோசனை. அவர் தனது பெயரை வெறுத்து, கேப்டன் கிட்னாப் என்ற பெயரால் அறியப்பட திட்டமிட்டார். ... \\z\n\tஅவருக்குத் தேவைப்படுவது கடத்துவதற்கு பிரபலமான ஒருவரை மட்டுமே. ... \\z\n\tஅவரது ஆண்களின் திறமை மற்றும் புத்திசாலித்தனம் இல்லாததால், அது ஒரு சாதனையாக இருந்திருக்கும். ... \\z\n\tகடந்த காலத்தில் நாங்கள் சேர்ந்து செய்த சில மோசடிகளில் இருந்து ஒருவரையொருவர் அறிந்தோம், அதனால் அவர் என்னை தொடர்பு கொண்டார். ... \\z\n\tநான் பிரபல இளவரசி லுமேலியாவாக நடிக்க இருந்தேன். உங்களுக்குத் தெரியும், எல்லோரும் தேடிக்கொண்டிருந்தவர். ... \\z\n\tஅது அவனுடைய ஆட்களுக்கும் மற்ற கடற்கொள்ளையர்களுக்கும் அவன் எவ்வளவு பெரிய கடத்தல்காரன் என்பதைக் காட்டும். ... \\z\n\tநான் அவனுடைய இரண்டாவது தளபதியாகி, கொள்ளையடிப்பது, கொள்ளையடிப்பது மற்றும் கொள்ளையடிப்பது போன்ற அற்புதமான வாழ்க்கையை நடத்துவேன் என்று அவர் எனக்கு உறுதியளித்தார். ... \\z\n\tஅதனால் சிறிது காலம் இளவரசி வேடத்தில் நடிக்க ஒப்புக்கொண்டேன், முதலில் அது நன்றாக வேலை செய்தது. ... \\z\n\tஅவர் என்னுடன் இளவரசி போல் உடை அணிந்து சொந்தமாக ஒரு சோதனையில் இருந்து திரும்பினார், உடனடியாக அவரது ஆட்களுக்கு அன்றைய ஹீரோவாக இருந்தார். ... \\z\n\tஅவர்கள் வெற்றி விழாவை நடத்த முடிவு செய்தபோது விஷயங்கள் மோசமாகிவிட்டன. ... \\z\n\tகடற்கொள்ளையர்களின் முணுமுணுப்புகளிலிருந்து என்னால் கண்டுபிடிக்க முடிந்தவரை, கிட் நிலத்தடி ஆற்றில் தன்னைத் தானே ஆசுவாசப்படுத்திக் கொள்ளும்போது எனது செல்லின் சாவியை இழந்தார். ... \\z\n\tமுட்டாள் அதன் பிறகு டைவ் செய்ய முடிவு செய்தான்.. இனி ஒருபோதும் பார்க்க முடியாது. ... \\z\n\tகிட் இறந்ததைப் பற்றி நான் அறிந்ததும், அது ஒரு புரளி என்று கடற்கொள்ளையர்களை நம்ப வைக்க முயற்சித்தேன், ஆனால் அவர்கள் என்னை நம்ப மாட்டார்கள்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.122005Z"
  },
  "npc.a_bearded_woman.stdmod_5": {
    "src_hash": "d02c0ffb00f9c85e39e5609e3ffcfc53",
    "text": "ஆ கடத்தல் மிகவும் வேடிக்கையாக உள்ளது. அதாவது, நீங்கள் பெறும் முடிவில் இல்லை என்றால். ... \\z\n\tஇது எளிதான பணம் மற்றும் எதிர்த்துப் போராட முடியாத ஒருவரை பயமுறுத்தவும் சித்திரவதை செய்யவும் உங்களுக்கு வாய்ப்பு உள்ளது!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.122926Z"
  },
  "npc.a_bearded_woman.stdmod_6": {
    "src_hash": "8addcda1b472b30e046fd34589b4879f",
    "text": "மக்கள் எவ்வளவு முட்டாளாக இருக்கிறாரோ, அவ்வளவு எளிதாக அவர்களை ஏமாற்ற முடியும். ... \\z\n\tமேலும் அவர்கள் ஏழைகளாக இருந்தால், அவர்கள் பழிவாங்க வேண்டும். ஹர் ஹர்! ... \\z\n\tஎனவே நான் மோசடி செய்பவர்களை அழிப்பதை உறுதி செய்கிறேன். பிறகு என்னைப் பழிவாங்குவதைத் தவிர அவர்களுக்கு வேறு விஷயங்கள் இருக்கின்றன.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.124003Z"
  },
  "npc.a_bearded_woman.stdmod_7": {
    "src_hash": "a07eb0740959112055b5524599e7a7e2",
    "text": "நிலத்தடி ஆற்றில் சாவி தொலைந்து போய் இப்போது ஏழு கடலில் அடித்துச் செல்லப்பட்டிருக்கலாம்! ... \\z\n\tஅந்த முட்டாள் குழந்தை கடத்தலில் மிகவும் வெறித்தனமாக இருந்திருக்கவில்லை என்றால், அவர் தனது கலங்களுக்கு மிகவும் விலையுயர்ந்த மற்றும் சிக்கலான பூட்டுகளை வாங்குவதற்காக தனது கப்பலை விற்றிருக்க மாட்டார்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.125144Z"
  },
  "npc.a_bearded_woman.stdmod_8": {
    "src_hash": "611cca91ceb08fc3c7143e9b26284ef9",
    "text": "பாதுகாப்பற்ற கடற்கரை நகரங்களில் நாம் ஒட்டிக்கொண்டிருக்கும் வரை, நாம் எளிதாக அதிர்ஷ்டத்தை உருவாக்க முடியும். ஹர் ஹர்! ... \\z\n\tநான் இங்கிருந்து வெளியேறியவுடன், இறுதியாக நானே ஒரு கடற்கொள்ளையர் கேப்டனாக மாறுவேன். எனக்கு கேப்டன் கிட் தேவையில்லை!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.126084Z"
  },
  "npc.a_bearded_woman.voice_1": {
    "src_hash": "58767cda40525ee7cbdee616d85cb646",
    "text": "நான் ஒரு மனிதன்! குடிகார முட்டாள்களே, என்னை வெளியேற்றுங்கள்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.126559Z"
  },
  "npc.a_bearded_woman.voice_2": {
    "src_hash": "72b86601b93166f02b9c4cd08dfeee5d",
    "text": "என்னை இங்கிருந்து வெளியேற்று!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.126881Z"
  },
  "npc.a_bearded_woman.voice_3": {
    "src_hash": "c28763b34d8b1e303d10487a3c6bdda4",
    "text": "என்னை வெளியேற்று! இது அனைத்தும் திட்டத்தின் ஒரு பகுதியாக இருந்தது, முட்டாள்களே!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.127341Z"
  },
  "npc.a_bearded_woman.voice_4": {
    "src_hash": "f6e4d063bc0eade947ac0001b744445e",
    "text": "நான் எப்போதாவது இங்கிருந்து வெளியேறினால், உங்கள் அனைவரையும் கொன்றுவிடுவேன்! நீங்கள் அனைவரும்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.127817Z"
  },
  "npc.a_bearded_woman.voice_5": {
    "src_hash": "610ef2c5395758ac8169140d09ad737a",
    "text": "நான் இளவரசி லுமேலியா அல்ல, முட்டாள்களே!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.128195Z"
  },
  "npc.a_bearded_woman.voice_6": {
    "src_hash": "53c4ab6007ae6d3e10ea4ddf7dce9bf1",
    "text": "ஒரு பூட்டு தொழிலாளியை அழைத்து என்னை விடுவித்து விடுங்கள் அல்லது நீங்கள் வருந்துவீர்கள், முட்டாள் கடற்கொள்ளையர்களே!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.128723Z"
  },
  "npc.a_bearded_woman.voice_7": {
    "src_hash": "6ad2054bb73e4f51e22543c42ffc5d5b",
    "text": "நான் இளவரசி அல்ல, நடிகன்!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-14T01:55:48.129077Z"
  },
  "npc.a_beautiful_girl.greet_msg_1": {
    "src_hash": "12c56c6555b96d78e471b6866d61e5dc",
