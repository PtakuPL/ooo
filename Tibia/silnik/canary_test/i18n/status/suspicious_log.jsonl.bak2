{"timestamp": "2026-02-14T15:56:54.696969Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_35", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}, {"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >82 znaków bez oczekiwanych diakrytyków dla es"}], "action": "retranslate", "en": "In the Dragonbone Cemetery, OBVIOUSLY! Must I explain EVERYTHING to you? Now go!", "translated": "En el Cementerio Dragonbone, ¡OBVIAMENTE! ¿Tengo que explicarte TODO? ¡Ahora vete!"}
{"timestamp": "2026-02-14T15:56:54.698120Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_35", "source": "tm", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}, {"type": "diacritics_missing", "severity": "LOW", "message": "Tekst >82 znaków bez oczekiwanych diakrytyków dla es"}], "en": "In the Dragonbone Cemetery, OBVIOUSLY! Must I explain EVERYTHING to you? Now go!", "translated": "En el Cementerio Dragonbone, ¡OBVIAMENTE! ¿Tengo que explicarte TODO? ¡Ahora vete!"}
{"timestamp": "2026-02-14T15:56:54.743071Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_82", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "action": "retranslate", "en": "Now... get out! And never, ever, dare come back! You ruined EVERYTHING!", "translated": "Ahora... ¡fuera! ¡Y nunca jamás te atrevas a volver! ¡Arruinaste TODO!"}
{"timestamp": "2026-02-14T15:56:54.744044Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_82", "source": "tm", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "en": "Now... get out! And never, ever, dare come back! You ruined EVERYTHING!", "translated": "Ahora... ¡fuera! ¡Y nunca jamás te atrevas a volver! ¡Arruinaste TODO!"}
{"timestamp": "2026-02-14T15:56:54.782497Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.voice_2", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "action": "retranslate", "en": "He will PAY for this... They will ALL pay!", "translated": "Él PAGARÁ por esto... ¡TODOS pagarán!"}
