# Local ignore rules for this subtree (Tibia/silnik)

# Ignore the whole Firma_budowlana project folder (as requested)
Firma_budowlana/

# Also ignore common secret/service-account JSON patterns just in case
*.json
*.json.*
# But allow i18n translation files
!canary_test/i18n/**/*.json
!canary_test/i18n/*.json

# Ignore Django media and local env files inside this subtree
**/media/
**/.env
**/.env.*

# OS/tooling noise
**/*.Zone.Identifier

# ===== I18N Worker temporary files =====
# Backup files
canary_test/backups/
**/*.bak
**/*.bak.*

