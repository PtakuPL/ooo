MainWindow
  !text: tr("otclient_modules.edit_hotkey_otui.tr_7")
  size: 360 160
  @onEscape: modules.game_actionbar.closeEditHotkeyWindow()

  FlatPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 25
    Label
      id: comboPreview
      !text: tr("otclient_modules.edit_hotkey_otui.tr_6", 'none')
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      text-auto-resize: true
      text-align: left

  Label
    !text: tr("otclient_modules.edit_hotkey_otui.tr_5")
    anchors.top: prev.bottom
    margin-top: 10
    text-auto-resize: true

  Label
    id: errorLabel
    !text: tr("otclient_modules.edit_hotkey_otui.tr_4")
    color: red
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 10
    visible: false

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 10

  Button
    id: applyButton
    !text: tr("otclient_modules.edit_hotkey_otui.tr_3")
    anchors.left: parent.left
    width: 80
    anchors.bottom: parent.bottom
    enabled: false
    @onClick: modules.game_actionbar.hotkeyCaptureOk(self:getParent(), self:getParent():recursiveGetChildById('comboPreview').keyCombo)

  Button
    id: clearButton
    !text: tr("otclient_modules.edit_hotkey_otui.tr_2")
    width: 80
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    @onClick: modules.game_actionbar.hotkeyClear(self:getParent())

  Button
    id: cancelButton
    !text: tr("otclient_modules.edit_hotkey_otui.tr_1")
    width: 80
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.game_actionbar.closeEditHotkeyWindow()
