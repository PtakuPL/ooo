
# Paste into modules/client_topmenu/topmenu.otui near other top bar buttons
Button < GameTopButton
  id: langTopButton
  icon-source: /images/topbuttons/language
  tooltip: tr("otclient_modules.topmenu_language_button_otui.tr_1")
  anchors.left: prev.right
  margin-left: 4
  onClick: modules.client_locales.openLanguagePicker()
