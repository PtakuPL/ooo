MainWindow
  width: 360
  !text: tr('Add hotkey preset')
  layout:
    type: verticalBox
    fit-children: true

  Label
    id: info
    font: noto-12
    color: #c0c0c0
    !text: tr('Enter a name for the new preset:')
  
  TextEdit
    id: field
    margin-top: 3
    height: 16
    padding: 1 4
    font: noto-12
    color: #c0c0c0

  HorizontalSeparator
    margin-top: 10

  Panel
    id: buttons
    margin-top: 10
    height: 20
    layout:
      type: horizontalBox
      align-right: true
      spacing: -8
    
    SmallButton
      id: ok
      width: 40
      !text: tr("Ok")
    
    SmallButton
      id: cancel
      width: 45
      !text: tr("Cancel")
  
