  "npc.a_bearded_woman.greet_msg_1": {
    "src_hash": "dec88b2ad57c0b13cc1cf44b9711944a",
    "text": "VODITE ME ODAVDE! SADA!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:41:19.093460Z"
  },
  "npc.a_bearded_woman.stdmod_1": {
    "src_hash": "85b863553a645f3e69472bcbeea15190",
    "text": "U pravednom svijetu, ja bih bio kapetan velikog broda, ... \\z\n\tTi pirati tamo bi sada bili moji sluge, a mi bismo hrabrili more i postali teror primorskih gradova! ... \\z\n\tDa je samo naš plan uspio!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:41:19.094034Z"
  },
  "npc.a_bearded_woman.stdmod_2": {
    "src_hash": "e665aff3c7b262f14bc1bdc6ecab7294",
    "text": "Kapetan Kid je prodao svoj brod da kupi besmislene stvari poput onih ludo skupih brava za vrata ćelije. ... \\z\n\tRekao je da će kanui poslužiti neko vrijeme. ... \\z\n\tStekao sam utisak da nije bio previše tužan što se rastaje od broda jer se znalo da je dosta patio od morske bolesti.",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:41:19.094716Z"
  },
  "npc.a_bearded_woman.stdmod_3": {
    "src_hash": "d0300a2639da1cea9ef53f1c6c9289c0",
    "text": "Bio bih mnogo bolji kapiten od Kida. Igrao sam nekoliko kapitena na sceni i bio sam dobar! ... \\z\n\tTamo gdje je Kid čeznuo za poštovanjem svojih ljudi, ja bih vladao strahom i gvozdenom šakom!",
    "source": "google_translate",
    "confidence": 0.9,
    "verified": false,
    "updated_at": "2026-02-12T23:41:19.095138Z"
  },
