UIWidget
  anchors.fill: parent
  visible: false
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    min-height: 60

    I18NQtButton
      !text: tr("otclient_modules.help_otui.tr_4")
      anchors.left: parent.left
      anchors.top: parent.top
      min-width: 130
      height: 20
      margin-bottom: 10
      margin-right: 10
      @onClick: g_platform.openUrl("https://github.com/mehah/otclient/wiki")

    I18NQtButton
      !text: tr("otclient_modules.help_otui.tr_3")
      min-width: 130
      height: 20
      margin-top: 5
     
      anchors.top: prev.bottom
      anchors.left: parent.left

      @onClick: g_platform.openUrl("https://github.com/mehah/otclient/wiki")

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    min-height: 55
    margin-top: 5

    I18NQtButton
      !text: tr("otclient_modules.help_otui.tr_2")
      min-width: 130
      height: 20
      margin-bottom: 10
      margin-right: 10
      anchors.left: parent.left
      anchors.top: parent.top
      @onClick: |
        g_settings.clear()
        controller:scheduleEvent(function()
          g_app.restart()
        end, 1000)
    I18NQtButton
      !text: tr("otclient_modules.help_otui.tr_1")
      min-width: 130
      height: 20
      margin-top: 5
      anchors.top: prev.bottom
      anchors.left: parent.left
      @onClick: |
        modules.client_locales.createWindow()
