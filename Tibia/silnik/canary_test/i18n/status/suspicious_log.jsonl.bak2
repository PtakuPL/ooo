{"timestamp": "2026-02-14T19:04:51.677896Z", "lang": "es", "category": "npc.json", "key": "npc.omrabas.multi_82", "source": "existing_value", "severity": "HIGH", "issues": [{"type": "artifact_tokens", "severity": "HIGH", "message": "Wykryto artefakty typu TODO/[LANG]/????"}], "action": "retranslate", "en": "Now... get out! And never, ever, dare come back! You ruined EVERYTHING!", "translated": "Ahora... ¡fuera! ¡Y nunca jamás te atrevas a volver! ¡Arruinaste TODO!"}
