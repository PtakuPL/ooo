{"timestamp": "2026-02-14T21:50:46.354294Z", "lang": "es", "category": "questlog.json", "key": "questlog.quest_47.mission_7.state_1", "source": "google_translate", "severity": "LOW", "issues": [{"type": "contains_tibia_proper_noun", "severity": "LOW", "message": "Tekst zawiera nazwę własną Tibia"}], "en": "Find the grave on an isle north-east of Ankrahmun.", "translated": "Encuentra la tumba en una isla al noreste de Ankrahmun."}
