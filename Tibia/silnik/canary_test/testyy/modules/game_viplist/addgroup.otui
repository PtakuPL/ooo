MainWindow
  size: 360 121
  !text: tr("otclient_modules.addgroup_otui.tr_4")
  text-offset: 0 1
  @onEnter: modules.game_viplist.addGroup()
  @onEscape: |
    self:destroy()
    modules.game_viplist.addGroupWindow = nil

  Label
    id: header
    !text: tr("otclient_modules.addgroup_otui.tr_3")
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    margin-top: -7
    margin-left: -1

  TextEdit
    id: name
    size: 328 16
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    padding-top: 0
    max-length: 40

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 11

  Button
    id: okButton
    !text: tr("otclient_modules.addgroup_otui.tr_2")
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 11
    margin-bottom: 6
    @onClick: modules.game_viplist.addGroup()

  Button
    !text: tr("otclient_modules.addgroup_otui.tr_1")
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 6
    @onClick: |
      self:getParent():destroy()
      modules.game_viplist.addGroupWindow = nil