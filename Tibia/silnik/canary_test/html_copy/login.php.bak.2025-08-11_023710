<?php
declare(strict_types=1);
header('Content-Type: application/json; charset=utf-8');

function env_get(string $k, $d=null){
  static $e=null;
  if($e===null){
    $e=[];
    $lines=@file(__DIR__.'/.env', FILE_IGNORE_NEW_LINES|FILE_SKIP_EMPTY_LINES);
    if($lines!==false){
      foreach($lines as $line){
        if($line===''||$line[0]==='#'||strpos($line,'=')===false) continue;
        [$kk,$vv]=array_map('trim', explode('=', $line, 2));
        $e[$kk]=trim($vv, "\"'");
      }
    }
  }
  return $e[$k]??$d;
}

$host=env_get('ENGINE_DB_HOST','127.0.0.1');
$name=env_get('ENGINE_DB_NAME','canary');
$user=env_get('ENGINE_DB_USER','root');
$pass=env_get('ENGINE_DB_PASS','');
$port=env_get('ENGINE_DB_PORT','3306');

try{
  $pdo=new PDO("mysql:host=$host;port=$port;dbname=$name;charset=utf8mb4",$user,$pass,[
    PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE=>PDO::FETCH_ASSOC,
  ]);
}catch(Throwable $e){
  http_response_code(500);
  echo json_encode(['error'=>true,'message'=>'DB connect failed','detail'=>$e->getMessage()]);
  exit;
}

echo json_encode(['ok'=>true,'db'=>$name], JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);
